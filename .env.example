# Finnhub (already required for FinancialProvider/CompanyBuilder/IPO calendar)
FINNHUB_API_KEY=

# SEC EDGAR (no key needed, but SEC requires a descriptive User-Agent
# identifying the requester or it will reject requests with a 403 —
# see https://www.sec.gov/os/webmaster-faq#developers)
SEC_EDGAR_USER_AGENT="IPO Sniper AI you@yourcompany.com"

# NewsAPI.org (real news provider — see NewsAPIProvider.ts for why
# this was chosen over Ground News)
NEWS_API_KEY=

# Financial Modeling Prep (real balance sheet detail - closes the
# Liquidity Analyst gap: currentRatio/quickRatio need current-portion
# assets/liabilities that Finnhub's basic financials don't break out)
FMP_API_KEY=

# Anthropic (optional — grounded LLM synthesis of the Executive
# Summary. Without this, the report falls back to the deterministic
# stats-line summary honestly, not an error. Haiku is the default
# model since this runs on every research request; override with
# ANTHROPIC_MODEL for a higher-quality/higher-cost model.)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Supabase (required for auth — see supabase/migrations/ for the
# profiles table schema these depend on)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — ADMIN-level, bypasses Row Level
# Security entirely. Server-only, never exposed to the client (see
# lib/supabase/serviceRole.ts). Get this from Supabase dashboard ->
# Project Settings -> API -> service_role key. Treat this like a
# root password, not a regular API key.
SUPABASE_SERVICE_ROLE_KEY=

# Cron endpoint auth (required once deployed — see
# app/api/cron/overnight-watch/route.ts). Vercel Cron automatically
# sends "Authorization: Bearer <CRON_SECRET>" when it invokes a
# scheduled function, so this needs to be set to a real random
# secret in Vercel's dashboard — without it, the cron route rejects
# every request (fails closed, not open). Generate one with:
# openssl rand -hex 32
CRON_SECRET=

# Alpaca Paper Trading (required for /hedge-fund's live paper-trading
# panel — see engine/trading/. Generate this key pair at
# app.alpaca.markets with the dashboard toggled to "Paper Trading" —
# live and paper keys are separate pairs, and a live key will not
# authenticate against ALPACA_PAPER_BASE_URL.)
ALPACA_API_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# Currents API (optional but recommended — real-time news, added
# alongside NewsAPI.org whose free tier has a documented 24h delay.
# Get a key at currentsapi.services. Read the comment atop
# engine/evidence/providers/CurrentsAPIProvider.ts before relying on
# this commercially — Currents' own docs state their free tier is
# for development/non-commercial use.)
CURRENTS_API_KEY=

# Public site URL (required for the Share Card's QR code to link
# anywhere real -- localhost can't be reached from someone's phone
# scanning a code on Twitter). Leave empty during local dev; the QR
# code is simply omitted from the card when this isn't set, rather
# than shipping a broken/localhost QR code.
NEXT_PUBLIC_SITE_URL=
