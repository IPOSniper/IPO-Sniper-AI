PS>foreach ($pattern in $providerPatterns) {

    $matches = Get-ChildItem `
        -Path "engine","lib","app","components" `
        -Recurse `
        -File `
        -Include *.ts,*.tsx |
        Select-String -Pattern $pattern -SimpleMatch |
        Select-Object -First 10

    if ($matches) {
        Write-Host ""
        Write-Host "[FOUND] $pattern" -ForegroundColor Green

        foreach ($match in $matches) {
            Write-Host "  $($match.Path):$($match.LineNumber)" -ForegroundColor DarkGray
        }
    }
    else {
        Write-Host "[NOT FOUND] $pattern" -ForegroundColor Yellow
    }
}

