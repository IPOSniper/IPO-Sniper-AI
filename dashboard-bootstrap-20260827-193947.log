]633;D;0]633;A]633;P;Cwd=C:\x5cUsers\x5cinago\x5cdev\x5cIPO_Sniper_AI_v4PS C:\Users\inago\dev\IPO_Sniper_AI_v4> ]633;B
]633;D]633;A]633;P;Cwd=C:\x5cUsers\x5cinago\x5cdev\x5cIPO_Sniper_AI_v4PS C:\Users\inago\dev\IPO_Sniper_AI_v4> ]633;B
PS>foreach ($file in $files) {

    if (-not (Test-Path $file)) {
        Write-Host "[MISSING] $file" -ForegroundColor Red
        continue
    }

    $lines = Get-Content $file

    if ($lines.Count -eq 0) {
        continue
    }

    $original = $lines[0]

    if ($original.StartsWith("-")) {

        $candidate = $original.Substring(1)

        $validStart =
            $candidate.StartsWith("import ") -or
            $candidate.StartsWith("export ") -or
            $candidate.StartsWith('"use client";')

        if ($validStart) {
            $lines[0] = $candidate

            Set-Content `
                -Path $file `
                -Value $lines `
                -Encoding UTF8

            Write-Host "[FIXED] $file" -ForegroundColor Green
            Write-Host "        $original"
            Write-Host "        $candidate"

            $changed++
        }
        else {
            Write-Host "[REVIEW] $file — leading '-' does not match expected corruption pattern" -ForegroundColor Yellow
        }
    }
    else {
        Write-Host "[OK] $file" -ForegroundColor DarkGray
    }
}
