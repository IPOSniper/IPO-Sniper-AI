# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.example has no real secrets -- it's a template meant to be
# committed, not a real secrets file. The broad .env* above was
# silently catching it too, meaning it was never actually version-
# controlled despite looking like it was in every packaged zip
# (those zip the working directory directly, not `git archive` --
# real gap, found while investigating a missing env var).
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Added during v4.00 Project Genesis
.env
.env.local
node_modules/
.next/
*.tsbuildinfo

.hedge-fund-layer2/
.env*
