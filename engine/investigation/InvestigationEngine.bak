import type { InvestigationQuestion } from "./contracts/InvestigationQuestion";
import type { InvestigationFinding } from "./contracts/InvestigationFinding";
import type { InvestigationReport } from "./contracts/InvestigationReport";

export class InvestigationEngine {

    investigate(
        analyst: string,
        questions: InvestigationQuestion[]
    ): InvestigationReport {

        const findings = questions.map(q => this.answerQuestion(q));

        return {

            analyst,

            completedQuestions: findings.length,

            totalQuestions: questions.length,

            overallConfidence: this.average(findings.map(f => f.confidence)),

            overallScore: this.average(findings.map(f => f.score)),

            findings

        };

    }

    private answerQuestion(
        question: InvestigationQuestion
    ): InvestigationFinding {

        return {

            questionId: question.id,

            answer: "",

            confidence: 0,

            score: 0,

            supportingEvidence: [],

            contradictingEvidence: [],

            assumptions: [],

            recommendation: ""

        };

    }

    private average(values: number[]): number {

        if (values.length === 0) return 0;

        return values.reduce((sum, value) => sum + value, 0) / values.length;

    }

}
