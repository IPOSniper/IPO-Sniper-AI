import CompanyHeader from "./CompanyHeader";
import ResearchProgress from "./ResearchProgress";
import ResearchDashboard from "./ResearchDashboard";
import ConvictionPanel from "./ConvictionPanel";
import InvestmentThesis from "./InvestmentThesis";
import CommitteeSummary from "./CommitteeSummary";
import EvidencePanel from "./EvidencePanel";

import { ResearchEngine } from "@/engine/research/researchEngine";

export default async function DashboardWorkstation() {

    const engine = new ResearchEngine();

    const report = await engine.analyze({
        ticker: "RKLB",
    });

    return (

        <div className="min-h-screen bg-slate-950 text-white">

            <CompanyHeader />

            <div className="grid grid-cols-12 gap-6">

                <aside className="col-span-2 space-y-6">

                    <ResearchProgress />

                </aside>

                <main className="col-span-7 rounded-xl border border-slate-800 bg-slate-900 p-6">

                    <InvestmentThesis report={report.committee} />

                    <CommitteeSummary report={report.committee} />

                    <ResearchDashboard />

                    <EvidencePanel report={report.committee} />

                </main>

                <ConvictionPanel score={report.conviction} />

            </div>

        </div>

    );

}